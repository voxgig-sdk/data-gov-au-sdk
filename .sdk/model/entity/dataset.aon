# Entity: dataset

main: kit: entity: dataset: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: false
      type: "`$STRING`"
    }
    {
      format: "email"
      name: "author_email"
      req: false
      type: "`$STRING`"
    }
    {
      name: "count"
      req: false
      short: "Total number of datasets matching the query"
      type: "`$INTEGER`"
    }
    {
      name: "facets"
      req: false
      short: "Faceted search results for aggregation"
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "license_id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "license_title"
      req: false
      type: "`$STRING`"
    }
    {
      name: "maintainer"
      req: false
      type: "`$STRING`"
    }
    {
      format: "email"
      name: "maintainer_email"
      req: false
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "metadata_created"
      req: false
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "metadata_modified"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "notes"
      req: false
      type: "`$STRING`"
    }
    {
      name: "organization"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "resources"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "results"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "search_facets"
      req: false
      short: "Search facet information"
      type: "`$OBJECT`"
    }
    {
      name: "tags"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "title"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "dataset"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "facet_field"
                orig: "facet_field"
                reqd: false
                type: "`$ARRAY`"
              }
              {
                example: "organization:health-dept"
                kind: "query"
                name: "fq"
                orig: "fq"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: false
                kind: "query"
                name: "include_private"
                orig: "include_private"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                example: "health"
                kind: "query"
                name: "q"
                orig: "q"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 10
                kind: "query"
                name: "row"
                orig: "row"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "metadata_modified desc"
                kind: "query"
                name: "sort"
                orig: "sort"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 0
                kind: "query"
                name: "start"
                orig: "start"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/action/package_search"
          segments: [
            {
              lit: "action"
            }
            {
              lit: "package_search"
            }
          ]
          select: {
            exist: [
              "facet_field"
              "fq"
              "include_private"
              "q"
              "row"
              "sort"
              "start"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.result`"
          }
        }
        {
          args: {
            query: [
              {
                kind: "query"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: false
                kind: "query"
                name: "include_tracking"
                orig: "include_tracking"
                reqd: false
                type: "`$BOOLEAN`"
              }
            ]
          }
          method: "GET"
          orig: "/action/package_show"
          segments: [
            {
              lit: "action"
            }
            {
              lit: "package_show"
            }
          ]
          select: {
            exist: [
              "id"
              "include_tracking"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.result`"
          }
        }
      ]
    }
  }



}
